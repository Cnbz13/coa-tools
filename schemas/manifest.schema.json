{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cnbz13/coa-tools/raw/main/schemas/manifest.schema.json",
  "title": "CoA Tools release manifest",
  "type": "object",
  "required": ["schemaVersion", "name", "version", "channel", "publishedAt", "minimumNodeVersion", "releaseUrl", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "const": "CoA Tools" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "channel": { "enum": ["stable", "beta", "nightly"] },
    "publishedAt": { "type": "string", "format": "date-time" },
    "minimumNodeVersion": { "type": "string" },
    "releaseUrl": { "type": "string", "format": "uri" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "component", "version", "platform", "arch", "targetFolder", "installPath", "file", "url", "sha256", "size"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "component": { "enum": ["addon-manager", "combat-assistant", "ui-manager", "loot-decider", "message-center", "heretic-helper", "event-alert", "grid-compat"] },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "contentVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "platform": { "enum": ["win32", "linux", "darwin", "any"] },
          "arch": { "enum": ["x64", "arm64", "any"] },
          "targetFolder": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "installPath": { "type": "string", "minLength": 1 },
          "file": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "upstream": {
            "type": "object",
            "required": ["name", "version", "targetFolder", "file", "url", "sha256", "size", "sourceUrl", "license"],
            "properties": {
              "name": { "const": "EventAlert" },
              "version": { "const": "4.3.6" },
              "targetFolder": { "const": "EventAlert" },
              "file": { "const": "EventAlert-4.3.6.zip" },
              "url": { "const": "https://edge.forgecdn.net/files/456/081/EventAlert-4.3.6.zip" },
              "sha256": { "const": "48c529fe42dedae8d7ed779f529e6cb55ba13a1d185b654804080a3bb9e4aa97" },
              "size": { "const": 27480 },
              "sourceUrl": { "type": "string", "format": "uri" },
              "license": { "const": "All Rights Reserved" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
